DISCORD_TOKEN=
CLIENT_ID=
# Optional: register commands in a single server for development
DISCORD_GUILD_ID=
# Optional: enable message edit/delete auditing (also enable Message Content Intent in Discord)
ENABLE_MESSAGE_AUDIT=false
# Optional: absolute path for bot state (defaults to your OS user-data folder)
BOT_DATA_DIR=
// REQUIRED FILE: PLEASE RENAME THIS FILE TO .env AND FILL IN THE VALUES ABOVE. DO NOT COMMIT YOUR .env FILE TO GIT.
